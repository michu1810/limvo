{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Headroom",
  "version": "0.1.0",
  "identifier": "app.headroom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "flyout",
        "url": "index.html",
        "title": "Headroom",
        "width": 380,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "windowEffects": { "effects": ["mica"] }
      },
      {
        "label": "strip",
        "url": "strip.html",
        "title": "Headroom strip",
        "width": 150,
        "height": 48,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "card",
        "url": "card.html",
        "title": "Headroom card",
        "width": 300,
        "height": 176,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "visible": false,
        "focus": false,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Plan limits in the Windows taskbar",
    "longDescription": "Headroom shows how much of your AI plan is left, with the pace you are using it at, in the Windows taskbar.",
    "copyright": "Headroom contributors, MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Headroom contributors",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Polish",
          "German",
          "Spanish",
          "French",
          "Italian",
          "PortugueseBR",
          "Ukrainian",
          "Hebrew",
          "Japanese",
          "SimpChinese"
        ],
        "customLanguageFiles": {
          "Polish": "installer/Polish.nsh",
          "Hebrew": "installer/Hebrew.nsh"
        },
        "compression": "lzma",
        "startMenuFolder": "Headroom"
      }
    }
  }
}
