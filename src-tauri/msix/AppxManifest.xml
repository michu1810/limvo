<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package. scripts/pack-msix.ps1 fills in the values in
  double braces: the identity comes from Partner Center (Product identity),
  the version from tauri.conf.json.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop com rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Limvo</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>See how much of your AI plan is left, right in the Windows taskbar.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <!-- The Widgets board API. The Store installs the runtime with Limvo. -->
    <PackageDependency
      Name="Microsoft.WindowsAppRuntime.1.8"
      MinVersion="8000.994.2142.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="pl-pl" />
    <Resource Language="de-de" />
    <Resource Language="es-es" />
    <Resource Language="fr-fr" />
    <Resource Language="it-it" />
    <Resource Language="pt-br" />
    <Resource Language="uk-ua" />
    <Resource Language="he-il" />
    <Resource Language="ja-jp" />
    <Resource Language="zh-hans" />
  </Resources>

  <Applications>
    <Application Id="Limvo" Executable="limvo.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Limvo"
        Description="See how much of your AI plan is left, right in the Windows taskbar."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Start at sign-in. Off until the user turns on Launch at login. -->
        <desktop:Extension Category="windows.startupTask" Executable="limvo.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="LimvoStartup" Enabled="false" DisplayName="Limvo" />
        </desktop:Extension>
        <!--
          The card on the Widgets board. limvo.exe is its own widget provider:
          it registers this class at start-up (src-tauri/src/widgets), and
          Windows starts Limvo when the board needs it and Limvo is not running.
          Never change the class id: pinned widgets find Limvo by it.
        -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="limvo.exe" DisplayName="Limvo">
              <com:Class Id="37549728-fbb6-4975-ae5e-047f0ba9d0a2" DisplayName="Limvo widget provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="Limvo" Id="LimvoWidgets" PublicFolder="Public">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\Square44x44Logo.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="37549728-fbb6-4975-ae5e-047f0ba9d0a2" />
                </Activation>
                <Definitions>
                  <Definition
                    Id="Limvo_Limits"
                    DisplayName="AI plan limits"
                    Description="How much of your AI plans is left, and whether it lasts to the reset."
                    AdditionalInfoUri="https://github.com/michu1810/limvo"
                    AllowMultiple="false">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Square44x44Logo.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Widgets\screenshot-light.png" DisplayAltText="Claude at 78% running hot, Codex at 23% and Copilot at 18%" />
                      </Screenshots>
                      <DarkMode>
                        <Screenshots>
                          <Screenshot Path="Assets\Widgets\screenshot-dark.png" DisplayAltText="Claude at 78% running hot, Codex at 23% and Copilot at 18%" />
                        </Screenshots>
                      </DarkMode>
                      <LightMode>
                        <Screenshots>
                          <Screenshot Path="Assets\Widgets\screenshot-light.png" DisplayAltText="Claude at 78% running hot, Codex at 23% and Copilot at 18%" />
                        </Screenshots>
                      </LightMode>
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
